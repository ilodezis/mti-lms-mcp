# Кука активной сессии ЛМС: открыть lms.mti.moscow, залогиниться,
# в консоли браузера выполнить  copy(document.cookie)  и вставить сюда.
LMS_COOKIE=
LMS_UA=Mozilla/5.0

# Необязательно, но избавляет от ручного обновления куки:
# при протухшей сессии сервер сам залогинится и перепишет LMS_COOKIE.
LMS_LOGIN=
LMS_PASSWORD=

# HTTP/SSE (удалённый MCP). Для http оба секрета обязательны, без них сервер
# не стартует. Два разных значения, каждое сгенерировать отдельно:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8030
MCP_TOKEN=
MCP_CLIENT_ID=mti-lms
MCP_CLIENT_SECRET=

